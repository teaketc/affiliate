# ---------- shared ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- apps/api ----------
PORT=3000
DATABASE_URL=postgresql://affiliate:affiliate@localhost:5432/affiliate?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-hex-string-0000000000000000000000
JWT_TTL_SECONDS=28800
# openssl rand -base64 32   (must decode to exactly 32 bytes)
CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# openssl rand -hex 16
CLICK_IP_SALT=change-me-0000000000000000

CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000
RATE_LIMIT_PER_MIN=300
# set true only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=false
PROVIDER_TIMEOUT_MS=15000
SYNC_CONCURRENCY=2
SWAGGER_ENABLED=true

# first admin (bun run db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=please-change-this-password

# ---------- apps/web ----------
# server-side only; the browser never calls the API directly
API_URL=http://localhost:3000
ORIGIN=http://localhost:5173
