// Shopee & Lazada Affiliate Data Service — PostgreSQL schema
// Generated SQL lives in prisma/migrations. Some objects Prisma cannot express
// (generated tsvector column, extensions, CHECK constraints) are added in the
// migration SQL by hand — see comments marked "MANUAL" there.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum Marketplace {
  SHOPEE
  LAZADA
}

enum AccountStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum SyncType {
  PRODUCTS
  PRICES
}

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum SyncTrigger {
  SCHEDULED
  MANUAL
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  apiKeys ApiKey[]
  apiLogs ApiLog[]

  @@map("users")
}

model ApiKey {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String
  /// First 12 chars of the key, shown in UI and used for lookup
  prefix          String    @unique
  /// SHA-256 hex of the full key — the key itself is never stored
  keyHash         String    @unique @map("key_hash")
  scopes          String[]  @default([])
  rateLimitPerMin Int       @default(120) @map("rate_limit_per_min")
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiLogs ApiLog[]

  @@index([userId])
  @@map("api_keys")
}

model AffiliateProvider {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            Marketplace @unique
  name            String
  baseUrl         String      @map("base_url")
  rateLimitPerSec Int         @default(2) @map("rate_limit_per_sec")
  isEnabled       Boolean     @default(true) @map("is_enabled")
  settings        Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts   AffiliateAccount[]
  products   Product[]
  categories Category[]

  @@map("affiliate_providers")
}

model AffiliateAccount {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId     String        @map("provider_id") @db.Uuid
  name           String
  /// ISO country code, e.g. TH
  region         String        @db.VarChar(2)
  /// Provider endpoint for this account (Shopee GraphQL URL / Lazada gateway)
  endpoint       String
  /// AES-256-GCM encrypted JSON of provider credentials. Never returned by the API.
  credentialsEnc String        @map("credentials_enc")
  status         AccountStatus @default(ACTIVE)
  settings       Json          @default("{}")
  lastSyncedAt   DateTime?     @map("last_synced_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider  AffiliateProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  links     AffiliateLink[]
  campaigns Campaign[]
  syncJobs  SyncJob[]

  @@unique([providerId, name])
  @@index([status])
  @@map("affiliate_accounts")
}

model Category {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String    @map("provider_id") @db.Uuid
  externalId String    @map("external_id")
  parentId   String?   @map("parent_id") @db.Uuid
  name       String
  slug       String
  level      Int       @default(1) @db.SmallInt
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider AffiliateProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@unique([providerId, externalId])
  @@index([parentId])
  @@index([providerId, slug])
  @@map("categories")
}

model Product {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId       String                   @map("provider_id") @db.Uuid
  externalId       String                   @map("external_id")
  shopId           String?                  @map("shop_id")
  shopName         String?                  @map("shop_name")
  brandName        String?                  @map("brand_name")
  name             String
  description      String?
  productUrl       String                   @map("product_url")
  imageUrl         String?                  @map("image_url")
  currency         String                   @default("THB") @db.Char(3)
  price            Decimal                  @db.Decimal(14, 2)
  originalPrice    Decimal?                 @map("original_price") @db.Decimal(14, 2)
  /// 0..1 (0.25 = 25%)
  discountRate     Decimal                  @default(0) @map("discount_rate") @db.Decimal(6, 4)
  /// 0..1 (0.1 = 10%)
  commissionRate   Decimal                  @default(0) @map("commission_rate") @db.Decimal(6, 4)
  commissionAmount Decimal?                 @map("commission_amount") @db.Decimal(14, 2)
  rating           Decimal?                 @db.Decimal(3, 2)
  salesCount       Int                      @default(0) @map("sales_count")
  stock            Int?
  isActive         Boolean                  @default(true) @map("is_active")
  raw              Json                     @default("{}")
  /// MANUAL: GENERATED ALWAYS AS (...) STORED — see migration
  searchVector     Unsupported("tsvector")? @map("search_vector")
  lastSyncedAt     DateTime                 @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider      AffiliateProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  categories    ProductCategory[]
  links         AffiliateLink[]
  priceHistory  PriceHistory[]
  promotions    Promotion[]

  @@unique([providerId, externalId])
  @@index([providerId, price])
  @@index([providerId, commissionRate(sort: Desc)])
  @@index([providerId, discountRate(sort: Desc)])
  @@index([providerId, salesCount(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([searchVector], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([raw(ops: JsonbPathOps)], type: Gin)
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  position  Int      @default(0) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId, position])
  @@map("product_images")
}

model ProductVariant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  externalId    String   @map("external_id")
  name          String
  price         Decimal  @db.Decimal(14, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(14, 2)
  stock         Int?
  attributes    Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId])
  @@map("product_variants")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Campaign {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String         @map("account_id") @db.Uuid
  name        String
  /// Used as subIds[0] / subId1 when generating links
  code        String
  description String?
  status      CampaignStatus @default(DRAFT)
  budget      Decimal?       @db.Decimal(14, 2)
  startsAt    DateTime?      @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime?      @map("ends_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  account AffiliateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  links   AffiliateLink[]

  @@unique([accountId, code])
  @@index([status])
  @@map("campaigns")
}

model AffiliateLink {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  productId   String?   @map("product_id") @db.Uuid
  campaignId  String?   @map("campaign_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  originUrl   String    @map("origin_url")
  /// Link returned by the marketplace
  shortLink   String    @map("short_link")
  /// Our own tracking code for /r/:code
  shortCode   String    @unique @map("short_code") @db.VarChar(16)
  subIds      String[]  @default([]) @map("sub_ids")
  clickCount  Int       @default(0) @map("click_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account  AffiliateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product  Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  campaign Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clicks   ClickEvent[]

  @@index([accountId, createdAt(sort: Desc)])
  @@index([campaignId, createdAt(sort: Desc)])
  @@index([productId])
  @@map("affiliate_links")
}

model PriceHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  price          Decimal  @db.Decimal(14, 2)
  originalPrice  Decimal? @map("original_price") @db.Decimal(14, 2)
  discountRate   Decimal  @default(0) @map("discount_rate") @db.Decimal(6, 4)
  commissionRate Decimal  @default(0) @map("commission_rate") @db.Decimal(6, 4)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt(sort: Desc)])
  @@map("price_histories")
}

model Promotion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  /// e.g. SHOPEE_OFFER_PERIOD, LAZADA_MM_CAMPAIGN, LAZADA_DM_INVITE
  type         String
  externalId   String    @map("external_id")
  name         String
  discountRate Decimal?  @map("discount_rate") @db.Decimal(6, 4)
  commissionRate Decimal? @map("commission_rate") @db.Decimal(6, 4)
  startsAt     DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(6)
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type, externalId])
  @@index([endsAt])
  @@map("promotions")
}

model SyncJob {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String      @map("account_id") @db.Uuid
  type       SyncType
  trigger    SyncTrigger
  status     SyncStatus  @default(QUEUED)
  /// BullMQ job id
  queueJobId String?     @map("queue_job_id")
  params     Json        @default("{}")
  stats      Json        @default("{}")
  attempts   Int         @default(0)
  error      String?
  startedAt  DateTime?   @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?   @map("finished_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  account AffiliateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("sync_jobs")
}

model ClickEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  linkId    String   @map("link_id") @db.Uuid
  /// SHA-256(ip + CLICK_IP_SALT) — raw IPs are never stored
  ipHash    String   @map("ip_hash") @db.Char(64)
  userAgent String?  @map("user_agent")
  referer   String?
  country   String?  @db.VarChar(2)
  subIds    Json     @default("{}") @map("sub_ids")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  link AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt(sort: Desc)])
  @@index([createdAt], type: Brin)
  @@map("click_events")
}

model ApiLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId  String   @map("request_id")
  userId     String?  @map("user_id") @db.Uuid
  apiKeyId   String?  @map("api_key_id") @db.Uuid
  method     String   @db.VarChar(8)
  path       String
  status     Int      @db.SmallInt
  durationMs Int      @map("duration_ms")
  ip         String?
  /// Audit action for mutating requests, e.g. "affiliate.generate-link"
  action     String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([createdAt], type: Brin)
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("api_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}
