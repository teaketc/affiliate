generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Marketplace {
  SHOPEE
  LAZADA
}

enum ShopType {
  MALL
  PREFERRED
  NORMAL
}

enum ExtractionStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model Product {
  id                String          @id @default(uuid()) @db.Uuid
  marketplace       Marketplace
  externalProductId String?         @map("external_product_id") @db.VarChar(128)
  productName       String          @map("product_name") @db.Text
  productImage      String?         @map("product_image") @db.Text
  productImages     Json            @default("[]") @map("product_images") @db.JsonB
  shopName          String?         @map("shop_name") @db.VarChar(255)
  shopType          ShopType?       @map("shop_type")
  price             Decimal?        @db.Decimal(12, 2)
  originalPrice     Decimal?        @map("original_price") @db.Decimal(12, 2)
  currency          String?         @db.VarChar(3)
  /// Canonical product URL (normalised, without tracking parameters).
  productUrl        String          @map("product_url") @db.Text
  /// Latest affiliate URL submitted for this product. Full history lives in extraction_logs.
  affiliateUrl      String          @map("affiliate_url") @db.Text
  rawData           Json?           @map("raw_data") @db.JsonB
  extractedAt       DateTime?       @map("extracted_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  extractionLogs    ExtractionLog[]

  @@unique([marketplace, externalProductId], map: "products_marketplace_external_product_id_key")
  @@unique([marketplace, productUrl], map: "products_marketplace_product_url_key")
  @@index([createdAt(sort: Desc)], map: "products_created_at_idx")
  @@index([marketplace, shopType], map: "products_marketplace_shop_type_idx")
  @@map("products")
}

model ExtractionLog {
  id            String           @id @default(uuid()) @db.Uuid
  affiliateUrl  String           @map("affiliate_url") @db.Text
  marketplace   Marketplace?
  productId     String?          @map("product_id") @db.Uuid
  product       Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  status        ExtractionStatus
  errorCode     String?          @map("error_code") @db.VarChar(64)
  errorMessage  String?          @map("error_message") @db.Text
  extractedData Json?            @map("extracted_data") @db.JsonB
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "extraction_logs_created_at_idx")
  @@index([status], map: "extraction_logs_status_idx")
  @@index([productId], map: "extraction_logs_product_id_idx")
  @@index([marketplace], map: "extraction_logs_marketplace_idx")
  @@map("extraction_logs")
}
