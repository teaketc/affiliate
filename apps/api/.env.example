# ---- Server ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info                 # debug | info | warn | error
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false              # true only behind a reverse proxy that sets X-Forwarded-For

# ---- Database ----
DATABASE_URL=postgresql://affiliate:affiliate@localhost:5432/affiliate?schema=public
# Disposable database used by integration tests (will be TRUNCATEd)
TEST_DATABASE_URL=postgresql://affiliate:affiliate@localhost:5432/affiliate_test?schema=public

# ---- Extraction ----
# live = fetch marketplace pages through the SSRF-safe client
# mock = development only, no network, products labelled "[MOCK]"
EXTRACTOR_MODE=live

# ---- Outbound fetch limits (SSRF hardening) ----
FETCH_TIMEOUT_MS=10000
FETCH_MAX_REDIRECTS=5
FETCH_MAX_RESPONSE_BYTES=3000000

# ---- Rate limit for POST /api/v1/extractor (per client IP) ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
