{
  "name": "@affiliate/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/unit && bun run test:integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "DATABASE_URL=$TEST_DATABASE_URL prisma migrate deploy && bun test tests/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@affiliate/shared": "workspace:*",
    "@elysiajs/cors": "1.4.0",
    "@elysiajs/swagger": "1.3.1",
    "@prisma/client": "6.19.3",
    "elysia": "1.4.28",
    "ipaddr.js": "2.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
